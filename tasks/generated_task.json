{
  "name": "CREATE A POSTER FROM TEMPLATES IN CANVA",
  "app": "Home - Canva - Google Chrome",
  "app_exe": "",
  "mode": "website",
  "steps": [
    {
      "step_number": 1,
      "action": "click",
      "description": "Click the 'Create a design' button to initiate a new design project.",
      "element": {
        "tag": "button",
        "text": "Create a design",
        "id": "create-design-btn",
        "class": "btn primary-button",
        "name": null,
        "role": "button",
        "aria_label": "Create a new design",
        "xpath": "//button[contains(.,'Create a design')]",
        "css_selector": "button.primary-button:contains('Create a design')",
        "parent_path": null
      }
    },
    {
      "step_number": 2,
      "action": "click",
      "description": "Select 'Poster' from the list of design types to start creating a poster.",
      "element": {
        "tag": "a",
        "text": "Poster",
        "id": "design-type-poster",
        "class": "design-type-option",
        "name": null,
        "role": "menuitem",
        "aria_label": "Create a Poster",
        "xpath": "//div[@role='menu']/a[contains(.,'Poster')]",
        "css_selector": "div[role='menu'] a.design-type-option:contains('Poster')",
        "parent_path": [
          "div[role='menu']"
        ]
      }
    }
  ]
}